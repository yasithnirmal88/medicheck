FROM node:20-alpine AS builder

WORKDIR /app

# Build-time VITE_ environment variables (Vite inlines these at build time).
# VITE_API_BASE_URL defaults to empty = "same origin", so /api/v1/... requests
# are proxied by nginx to the backend. Override via --build-arg if the API is
# hosted on a separate origin.
ARG VITE_API_BASE_URL=
ARG VITE_FIREBASE_API_KEY=
ARG VITE_FIREBASE_AUTH_DOMAIN=
ARG VITE_FIREBASE_PROJECT_ID=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:1.25-alpine AS runner

RUN apk add --no-cache curl

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
# ssl.conf is a reference template for enabling HTTPS; it is comment-only and
# safe to keep, but it must not introduce a second active server block.
COPY --from=builder /app/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl --fail http://localhost:80/nginx-health || exit 1

EXPOSE 80
EXPOSE 443

CMD ["nginx", "-g", "daemon off;"]
